  <norm doknr="P31A">
    <metadaten>
      <jurabk>BGB</jurabk>
      <enbez>§ 31a</enbez>
      <titel format="XML">Haftung von Organmitgliedern</titel>
    </metadaten>
    <textdaten>
      <text format="XML">
        <Content>
          <P>(1) Organmitglieder haften nur bei Vorsatz oder grober Fahrlässigkeit.</P>
          <P>(2) Sie können Befreiung von der Verbindlichkeit verlangen.</P>
        </Content>
      </text>
    </textdaten>
  </norm>
  <norm doknr="P433">
    <metadaten>
      <jurabk>BGB</jurabk>
      <enbez>§ 433</enbez>
      <titel format="parat">Vertragstypische Pflichten beim Kaufvertrag</titel>
    </metadaten>
    <textdaten>
      <text format="XML">
        <Content>
          <P>(1) Durch den Kaufvertrag wird der Verkäufer einer Sache verpflichtet, dem Käufer die Sache zu übergeben.</P>
          <P>(2) Der Käufer ist verpflichtet, den vereinbarten Kaufpreis zu zahlen.</P>
        </Content>
      </text>
    </textdaten>
  </norm>
